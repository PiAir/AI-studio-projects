<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <title>Video Embed</title>
  <style>
    body, html {
      margin: 0;
      padding: 0;
      height: 100%;
      background: #000;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    video {
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
      background: #000;
    }
  </style>
</head>
<body>
  <video id="player" controls preload="metadata"></video>

  <script>
    // Haal de video_url parameter uit de querystring
    const params = new URLSearchParams(window.location.search);
    const videoUrl = params.get("video_url");

    if (videoUrl) {
      const player = document.getElementById("player");
      const source = document.createElement("source");
      source.src = videoUrl;
      source.type = "video/mp4";
      player.appendChild(source);
    } else {
      document.body.innerHTML = "<p style='color:white;'>Geen video_url opgegeven.</p>";
    }
  </script>
</body>
</html>
